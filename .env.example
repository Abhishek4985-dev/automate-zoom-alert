ZOOM_WEBHOOK_URL=https://integrations.zoom.us/chat/webhooks/incomingwebhook/XXXXXXXX
ZOOM_WEBHOOK_SECRET=your-secret-token
# Zoom's doc formula says base64UrlEncode but its example uses plain base64.
# Switch to base64url only if you get 401/signature errors.
ZOOM_SIGNATURE_ENCODING=base64
TARGET_URL=https://example.com/dashboard
SCREENSHOT_FULL_PAGE=false
SCREENSHOT_MESSAGE=Daily snapshot
KEEP_DAYS=30
